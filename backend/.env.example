# SQL Server connection used by Spring Boot.
# Do not commit a real .env file or real credentials.
DB_HOST=ADMIN
DB_PORT=1433
DB_NAME=QuanLyNhaTro
DB_USERNAME=sa
DB_PASSWORD=change-me
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_LOGIN_TIMEOUT=30
SERVER_PORT=8080
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
DB_INSTANCE=BANG
JWT_SECRET=change-me-base64-secret-at-least-32-bytes
# VietQR receiving account. Leave empty to disable QR generation.
VIETQR_BANK_CODE=ICB
VIETQR_BANK_ACCOUNT=
VIETQR_ACCOUNT_NAME=
# Gemini AI assistant (https://aistudio.google.com/apikey). Leave empty to use keyword matching.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
